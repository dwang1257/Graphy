{
  "name": "graphy",
  "version": "1.0.0",
  "description": "Chrome extension that renders LeetCode custom test cases as interactive graphs.",
  "scripts": {
    "preinstall": "node ./scripts/ensure-local-node-modules.mjs",
    "postinstall": "node ./scripts/ensure-local-node-modules.mjs && node ./scripts/patch-rxjs-node.mjs",
    "prebuild": "node ./scripts/ensure-local-node-modules.mjs --check && node ./scripts/patch-rxjs-node.mjs",
    "pretest": "node ./scripts/ensure-local-node-modules.mjs --check && node ./scripts/patch-rxjs-node.mjs",
    "dev": "vite",
    "build": "vite build",
    "test": "node --test scripts/rxjs-node-import.test.mjs scripts/package-release.test.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --pretty false && node ./scripts/lint.mjs",
    "package": "npm run build && node ./scripts/package-release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwang1257/Graphy.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/dwang1257/Graphy/issues"
  },
  "homepage": "https://github.com/dwang1257/Graphy#readme",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.2.7",
    "@types/node": "^26.3.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@hpcc-js/wasm-graphviz": "^1.28.0",
    "preact": "^10.29.8"
  },
  "private": true
}
