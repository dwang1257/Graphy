{
  "manifest_version": 3,
  "name": "Graphy",
  "version": "1.0.1",
  "description": "Renders LeetCode custom test cases as interactive graphs.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Toggle Graphy"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-D9deO-aB.js"
      ],
      "matches": [
        "https://leetcode.com/*",
        "https://leetcode.cn/*"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://leetcode.cn/*",
        "https://leetcode.com/*"
      ],
      "resources": [
        "injected.js",
        "src/panel/index.html",
        "assets/protocol-BlOzJiD5.js",
        "assets/index.ts-DPywxHBI.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'"
  }
}
